.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Large Dataset Files (Exceeding GitHub 100MB Limit & Raw CICIDS Dumps)
dataset/UNSW-NB15_1.csv
dataset/UNSW-NB15_2.csv
dataset/UNSW-NB15_3.csv
dataset/UNSW-NB15_4.csv
dataset/*.parquet
dataset/Midterm_53_group.csv
dataset/output1.csv
dataset/network_traffic_dataset.csv
